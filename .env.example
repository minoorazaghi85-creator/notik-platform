# Notik Platform Environment Variables
# Copy this file to .env and change the values before running.

# Database
MYSQL_ROOT_PASSWORD=notik_root_pass_change_me
MYSQL_DATABASE=notik
MYSQL_USER=notik
MYSQL_PASSWORD=notik_pass_change_me

# WordPress
WP_PORT=8080
WORDPRESS_DEBUG=1

# phpMyAdmin (optional, use with --profile tools)
PMA_PORT=8081

# Site URL (used in setup scripts)
SITE_URL=http://localhost:8080
SITE_TITLE=نوتیک | بازار فایل‌های آموزشی دانشجویی
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_EMAIL=admin@example.com

# Commission (percentage, configurable later in Dokan settings)
# DO NOT hardcode final rates in code; set via admin panel
DEFAULT_COMMISSION=10
